10 REM ==========================================================
20 REM  WOHNUNGSPLANER.BAS - GRUNDRISS-EDITOR FUER AMIGABASIC
30 REM  Laeuft auf jedem Commodore Amiga mit AmigaBASIC
40 REM  (OS 1.x bis 3.x, AmigaBASIC liegt auf der Diskette "Extras").
50 REM  Bedienung: Maus klicken = zeichnen, Tasten siehe Statusfenster.
60 REM  Falls Maus-Koordinaten versetzt: MX0/MY0 in Zeile 120 anpassen.
70 REM ==========================================================
80 DIM WX1(199),WY1(199),WX2(199),WY2(199),WT(199)
90 DIM RX(99),RY(99),RW(99),RH(99),RN$(99)
100 DIM FX(199),FY(199),FT(199)
110 DIM FT$(15),FW(15),FH(15)
120 NW=0:NR=0:NM=0:NF=0
130 SC=20:OX=40:OY=20:TOOL=1:DIMON=1:CURF=1:PEND=0:OLDB=0:MX0=0:MY0=0
140 ST$="Bereit. Massstab 1 m = "+STR$(SC)+" px, Rasterfang 10 cm."
150 SCREEN 1
160 PALETTE 0,0,0,0:PALETTE 1,1,1,1:PALETTE 2,0.75,0.75,0.75
170 PALETTE 3,1,0.85,0.2:PALETTE 4,0.35,0.55,0.9:PALETTE 5,0.9,0.6,0.35
180 WINDOW 1,"Wohnungsplaner (AmigaBASIC) - Status",(0,0)-(639,33),1
190 WINDOW 2,"Grundriss - mit der Maus zeichnen",(0,34)-(639,199),,1
200 MOUSE ON
210 GOSUB 1000
220 GOSUB 2000
230 GOSUB 3200
240 REM ============ HAUPTSCHLEIFE ============
250 K$=INKEY$
260 IF K$<>"" THEN GOSUB 3000
270 B=MOUSE(2)
280 IF B<>0 AND OLDB=0 THEN GOSUB 4000:GOSUB 3200
290 IF B=0 THEN OLDB=0
300 GOTO 250
310 REM ============ MOEBEL-TABELLE ============
1000 DATA "Bett 160x200",1.6,2
1010 DATA "Doppelbett 180x200",1.8,2
1020 DATA "Sofa 220x90",2.2,0.9
1030 DATA "Sessel 80x80",0.8,0.8
1040 DATA "Esstisch 160x90",1.6,0.9
1050 DATA "Stuhl 45x45",0.45,0.45
1060 DATA "Schrank 120x60",1.2,0.6
1070 DATA "Kuechenzeile 300x60",3,0.6
1080 DATA "Badewanne 170x75",1.7,0.75
1090 DATA "Dusche 90x90",0.9,0.9
1100 DATA "WC 40x70",0.4,0.7
1110 DATA "Waschbecken 60x50",0.6,0.5
1120 DATA "TV-Regal 120x10",1.2,0.1
1130 DATA "Teppich 200x150",2,1.5
1140 DATA "Zimmerpflanze 40x40",0.4,0.4
1150 DATA "Zimmerpflanze gross 60x60",0.6,0.6
1160 FOR I=1 TO 16:READ FT$(I),FW(I),FH(I):NEXT I
1170 NF=16
1180 RETURN
1190 REM ============ NEU ZEICHNEN ============
2000 WINDOW OUTPUT 2:COLOR 1,0
2010 LINE (0,0)-(639,165),0,BF
2020 FOR GX=0 TO 30
2030 FOR GY=0 TO 8
2040 IF OX+GX*SC<=639 AND OY+GY*SC<=165 THEN PSET (OX+GX*SC,OY+GY*SC),2
2050 NEXT GY
2060 NEXT GX
2070 FOR I=1 TO NR
2080 X=OX+RX(I)*SC:Y=OY+RY(I)*SC:W=RW(I)*SC:H=RH(I)*SC
2090 LINE (X,Y)-(X+W,Y+H),4,BF
2100 NEXT I
2110 FOR I=1 TO NW
2120 X1=OX+WX1(I)*SC:Y1=OY+WY1(I)*SC:X2=OX+WX2(I)*SC:Y2=OY+WY2(I)*SC
2130 DX=X2-X1:DY=Y2-Y1:L=SQR(DX*DX+DY*DY)
2140 IF L>0 THEN GOSUB 2200
2150 NEXT I
2160 FOR I=1 TO NM
2170 X=OX+FX(I)*SC-FW(FT(I))*SC/2:Y=OY+FY(I)*SC-FH(FT(I))*SC/2
2180 W=FW(FT(I))*SC:H=FH(FT(I))*SC
2190 LINE (X,Y)-(X+W,Y+H),5,BF
2195 IF FT(I)=1 THEN LINE (X+W*0.1,Y+H*0.4)-(X+W*0.9,Y+H*0.4),0
2196 NEXT I
2197 IF DIMON=1 THEN GOSUB 2300
2198 RETURN
2200 REM --- dicke Wand als Rechteck ---
2210 UX=DX/L:UY=DY/L:NX=-UY:NY=UX:T=WT(I)*SC/2
2220 LINE (X1+NX*T,Y1+NY*T)-(X2+NX*T,Y2+NY*T),1
2230 LINE (X2+NX*T,Y2+NY*T)-(X2-NX*T,Y2-NY*T),1
2240 LINE (X2-NX*T,Y2-NY*T)-(X1-NX*T,Y1-NY*T),1
2250 LINE (X1-NX*T,Y1-NY*T)-(X1+NX*T,Y1+NY*T),1
2260 PAINT ((X1+X2)/2,(Y1+Y2)/2),1,1
2270 RETURN
2300 REM --- Bemassungslinien ---
2310 FOR I=1 TO NW
2320 X1=OX+WX1(I)*SC:Y1=OY+WY1(I)*SC:X2=OX+WX2(I)*SC:Y2=OY+WY2(I)*SC
2330 DX=X2-X1:DY=Y2-Y1:L=SQR(DX*DX+DY*DY)
2340 IF L>0 THEN GOSUB 2400
2350 NEXT I
2360 RETURN
2400 UX=DX/L:UY=DY/L:NX=-UY:NY=UX:OF=WT(I)*SC/2+6
2410 LINE (X1+NX*OF,Y1+NY*OF)-(X2+NX*OF,Y2+NY*OF),3
2420 LINE (X1+NX*OF-3,Y1+NY*OF-3)-(X1+NX*OF+3,Y1+NY*OF+3),3
2430 LINE (X2+NX*OF-3,Y2+NY*OF-3)-(X2+NX*OF+3,Y2+NY*OF+3),3
2440 RETURN
2450 REM ============ TASTEN ============
3000 IF K$="q" OR K$="Q" THEN WINDOW OUTPUT 1:CLS:END
3010 IF K$="1" THEN TOOL=1:ST$="Werkzeug: WAND (2 Klicks)"
3020 IF K$="2" THEN TOOL=2:ST$="Werkzeug: RAUM (2 Klicks = Ecken)"
3030 IF K$="3" THEN TOOL=3:ST$="Werkzeug: MOEBEL setzen, F=naechstes Moebel"
3040 IF K$="4" THEN TOOL=4:ST$="Werkzeug: LOESCHEN (Klick auf Objekt)"
3050 IF K$="f" OR K$="F" THEN CURF=CURF+1:IF CURF>NF THEN CURF=1:ST$="Moebel: "+FT$(CURF)
3060 IF K$="b" OR K$="B" THEN DIMON=1-DIMON:ST$="Bemassung umgeschaltet":GOSUB 2000
3070 IF K$="m" OR K$="M" THEN GOSUB 5000:RETURN
3080 IF K$="s" OR K$="S" THEN GOSUB 4500:RETURN
3090 IF K$="l" OR K$="L" THEN GOSUB 4700:RETURN
3100 IF K$="n" OR K$="N" THEN NW=0:NR=0:NM=0:PEND=0:ST$="Neuer Plan":GOSUB 2000
3110 IF K$="+" OR K$="=" THEN SC=SC+2:IF SC>60 THEN SC=60:ST$="Massstab 1 m = "+STR$(SC)+" px":GOSUB 2000
3120 IF K$="-" THEN SC=SC-2:IF SC<6 THEN SC=6:ST$="Massstab 1 m = "+STR$(SC)+" px":GOSUB 2000
3130 GOSUB 3200
3140 RETURN
3150 REM ============ STATUSFENSTER ============
3200 WINDOW OUTPUT 1:COLOR 0,1:CLS
3210 PRINT "1=Wand 2=Raum 3=Moebel 4=Loeschen | F=Moebel B=Bemassung M=Masse +/- Zoom"
3220 PRINT "S=Speichern L=Laden N=Neu Q=Ende"
3230 PRINT "Werkzeug: ";
3240 IF TOOL=1 THEN PRINT "WAND  ";
3250 IF TOOL=2 THEN PRINT "RAUM  ";
3260 IF TOOL=3 THEN PRINT "MOEBEL ";FT$(CURF);"  ";
3270 IF TOOL=4 THEN PRINT "LOESCHEN  ";
3280 PRINT "| ";ST$
3290 WINDOW OUTPUT 2:RETURN
3300 REM ============ MAUSKLICK ============
4000 MX=MOUSE(0)-MX0:MY=MOUSE(1)-MY0
4010 WX=(MX-OX)/SC:WY=(MY-OY)/SC
4020 WX=INT(WX*10+0.5)/10:WY=INT(WY*10+0.5)/10
4030 IF TOOL=1 THEN GOSUB 4100
4040 IF TOOL=2 THEN GOSUB 4200
4050 IF TOOL=3 THEN GOSUB 4300
4060 IF TOOL=4 THEN GOSUB 4400
4070 RETURN
4100 REM --- Wand: 2 Klicks ---
4110 IF PEND=0 THEN AX=WX:AY=WY:PEND=1:ST$="Wand-Anfang - zweiter Klick setzt Ende":RETURN
4120 PEND=0
4130 IF NW>=199 THEN ST$="Zu viele Waende!":RETURN
4140 NW=NW+1:WX1(NW)=AX:WY1(NW)=AY:WX2(NW)=WX:WY2(NW)=WY:WT(NW)=0.2
4150 N=SQR((WX-AX)^2+(WY-AY)^2):GOSUB 4900
4160 ST$="Wand "+STR$(NW)+": Laenge "+S$+" m"
4170 GOSUB 2000:RETURN
4200 REM --- Raum: 2 Klicks = Ecken ---
4210 IF PEND=0 THEN AX=WX:AY=WY:PEND=1:ST$="Raum-Ecke 1 - zweiter Klick = gegenueber":RETURN
4220 PEND=0:X=AX:Y=AY:W=WX-AX:H=WY-AY
4230 IF W<0 THEN X=WX:W=-W
4240 IF H<0 THEN Y=WY:H=-H
4250 IF W<0.5 OR H<0.5 THEN ST$="Raum zu klein (min. 0,5 m)":RETURN
4260 IF NR>=99 THEN ST$="Zu viele Raeume!":RETURN
4270 NR=NR+1:RX(NR)=X:RY(NR)=Y:RW(NR)=W:RH(NR)=H:RN$(NR)="Raum "+STR$(NR)
4280 N=W*H:GOSUB 4900:A$=S$:N=W:GOSUB 4900:B$=S$:N=H:GOSUB 4900
4290 ST$=RN$(NR)+": Flaeche "+A$+" qm ("+B$+" x "+S$+" m)"
4300 GOSUB 2000:RETURN
4310 REM --- Moebel platzieren ---
4320 IF NM>=199 THEN ST$="Zu viele Moebel!":RETURN
4330 NM=NM+1:FX(NM)=WX:FY(NM)=WY:FT(NM)=CURF
4340 N=FW(CURF):GOSUB 4900:A$=S$:N=FH(CURF):GOSUB 4900
4350 ST$=FT$(CURF)+": Breite "+A$+" m, Laenge "+S$+" m"
4360 GOSUB 2000:RETURN
4400 REM --- Loeschen: naechstes Objekt ---
4410 BD=0.2:BI=0
4420 FOR I=1 TO NW
4430 DX=WX2(I)-WX1(I):DY=WY2(I)-WY1(I):L2=DX*DX+DY*DY
4440 IF L2=0 THEN D=SQR((WX-WX1(I))^2+(WY-WY1(I))^2):GOTO 4470
4450 T=((WX-WX1(I))*DX+(WY-WY1(I))*DY)/L2
4460 IF T<0 THEN T=0
4465 IF T>1 THEN T=1
4466 D=SQR((WX-WX1(I)-T*DX)^2+(WY-WY1(I)-T*DY)^2)
4470 IF D<BD THEN BD=D:BI=I
4480 NEXT I
4490 IF BI>0 THEN WX1(BI)=WX1(NW):WY1(BI)=WY1(NW):WX2(BI)=WX2(NW):WY2(BI)=WY2(NW):WT(BI)=WT(NW):NW=NW-1:ST$="Wand geloescht":GOSUB 2000:RETURN
4500 FOR I=NR TO 1 STEP -1
4510 IF WX>=RX(I) AND WX<=RX(I)+RW(I) AND WY>=RY(I) AND WY<=RY(I)+RH(I) THEN RX(I)=RX(NR):RY(I)=RY(NR):RW(I)=RW(NR):RH(I)=RH(NR):RN$(I)=RN$(NR):NR=NR-1:ST$="Raum geloescht":GOSUB 2000:RETURN
4520 NEXT I
4530 ST$="Nichts in der Naehe gefunden":RETURN
4540 REM --- Speichern ---
4550 WINDOW OUTPUT 1:COLOR 0,1
4560 OPEN "DF0:WPPLAN.TXT" FOR OUTPUT AS #1
4570 PRINT #1,"WOHNUNGSPLANER1"
4580 FOR I=1 TO NW
4590 PRINT #1,"W ";WX1(I);" ";WY1(I);" ";WX2(I);" ";WY2(I);" ";WT(I)
4600 NEXT I
4610 FOR I=1 TO NR
4620 PRINT #1,"R ";RX(I);" ";RY(I);" ";RW(I);" ";RH(I)
4630 NEXT I
4640 FOR I=1 TO NM
4650 PRINT #1,"F ";FT(I);" ";FX(I);" ";FY(I)
4660 NEXT I
4670 CLOSE #1
4680 ST$="Gespeichert: DF0:WPPLAN.TXT":GOSUB 3200:RETURN
4690 REM --- Laden ---
4700 WINDOW OUTPUT 1:COLOR 0,1
4710 ON ERROR GOTO 4800
4720 OPEN "DF0:WPPLAN.TXT" FOR INPUT AS #1
4730 NW=0:NR=0:NM=0:PEND=0
4740 WHILE NOT EOF(1)
4750 LINE INPUT #1,A$:P=1:GOSUB 4850:K$=T$
4760 IF K$="W" AND NW<199 THEN NW=NW+1:GOSUB 4850:WX1(NW)=VAL(T$):GOSUB 4850:WY1(NW)=VAL(T$):GOSUB 4850:WX2(NW)=VAL(T$):GOSUB 4850:WY2(NW)=VAL(T$):GOSUB 4850:WT(NW)=VAL(T$)
4770 IF K$="R" AND NR<99 THEN NR=NR+1:GOSUB 4850:RX(NR)=VAL(T$):GOSUB 4850:RY(NR)=VAL(T$):GOSUB 4850:RW(NR)=VAL(T$):GOSUB 4850:RH(NR)=VAL(T$):RN$(NR)="Raum "+STR$(NR)
4780 IF K$="F" AND NM<199 THEN NM=NM+1:GOSUB 4850:FT(NM)=INT(VAL(T$)):GOSUB 4850:FX(NM)=VAL(T$):GOSUB 4850:FY(NM)=VAL(T$)
4790 WEND
4800 CLOSE #1
4810 ON ERROR GOTO 0
4820 ST$="Geladen: "+STR$(NW)+" Waende, "+STR$(NR)+" Raeume, "+STR$(NM)+" Moebel"
4830 GOSUB 3200:GOSUB 2000:RETURN
4840 REM --- Token aus A$ ab P lesen ---
4850 T$=""
4860 IF P>LEN(A$) THEN RETURN
4870 IF MID$(A$,P,1)=" " THEN P=P+1:GOTO 4860
4880 C$=MID$(A$,P,1)
4890 IF C$<>" " AND P<=LEN(A$) THEN T$=T$+C$:P=P+1:GOTO 4880
4895 RETURN
4900 REM --- N (Meter) -> S$ mit Komma, 1 Nachkommastelle ---
4910 V=INT(N*10+0.5)
4920 S$=STR$(INT(V/10))+","+STR$(V-INT(V/10)*10)
4930 S2$="":FOR J=1 TO LEN(S$):C$=MID$(S$,J,1):IF C$<>" " THEN S2$=S2$+C$:NEXT J
4940 S$=S2$:RETURN
4950 REM --- Massliste ---
5000 WINDOW OUTPUT 1:COLOR 0,1:CLS
5010 PRINT "MASSLISTE (Meter):"
5020 FOR I=1 TO NW
5030 N=SQR((WX2(I)-WX1(I))^2+(WY2(I)-WY1(I))^2):GOSUB 4900
5040 PRINT "Wand ";I;": ";S$+" m"
5050 NEXT I
5060 FOR I=1 TO NR
5070 N=RW(I)*RH(I):GOSUB 4900
5080 PRINT RN$(I);": ";S$+" qm"
5090 NEXT I
5100 FOR I=1 TO NM
5110 N=FW(FT(I)):GOSUB 4900:A$=S$:N=FH(FT(I)):GOSUB 4900
5120 PRINT FT$(FT(I));": Breite ";A$+" m, Laenge ";S$+" m"
5130 NEXT I
5140 PRINT "--- Taste druecken ---"
5150 A$=INKEY$:WHILE A$="":A$=INKEY$:WEND
5160 GOSUB 3200:GOSUB 2000:RETURN
